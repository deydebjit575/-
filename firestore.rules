rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isHospitalStaff() {
      return isAuthenticated() && request.auth.token.role == 'hospital_staff';
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Patient Profiles
    match /patientProfiles/{profileId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isHospitalStaff() || isAdmin());
      allow write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Medical Documents (MediVault)
    match /medicalDocuments/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        isHospitalStaff() || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
    
    // Medical Timeline
    match /medicalTimeline/{timelineId} {
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isHospitalStaff() || isAdmin());
      allow write: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isAdmin());
    }
    
    // Emergency Requests
    match /emergencyRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isHospitalStaff() || isAdmin() || (resource.data.patientId == request.auth.uid);
    }
    
    // Bed Availability
    match /bedAvailability/{bedId} {
      allow read: if true; // Publicly verifiable by seniors & patients
      allow write: if isHospitalStaff() || isAdmin();
    }
    
    // Document Access Grants
    match /documentAccessGrants/{grantId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isAdmin());
    }
    
    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
